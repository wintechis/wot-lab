@prefix ex:     <https://example.org/passport/> .
@prefix schema: <https://schema.org/> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .

<#phone>
    a                       ex:Smartphone ;
    schema:name             "Xiaomi 15T" ;
    schema:brand            "Xiaomi" ;
    schema:model            "25069PTEBG" ;
    schema:subjectOf        <https://eprel.ec.europa.eu/qr/2387432> ;
    ex:batteryEndurance     <#batteryEndurance> ;
    ex:battery              <battery.ttl#battery> ;
    ex:trace                <trace.ttl#trace> .

<#batteryEndurance>
    a                       qudt:QuantityValue ;
    qudt:numericValue       57.73 ;
    qudt:unit               unit:HR .
