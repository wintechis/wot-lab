@prefix ex:     <https://solidtest.iis.fraunhofer.de/rocky/shapes/passport.vocab.ttl#> .
@prefix schema: <https://schema.org/> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .

<#phone>
    a                       ex:Smartphone ;
    schema:name             "Apple iPhone 16" ;
    schema:brand            "Apple" ;
    schema:model            "A3287" ;
    schema:subjectOf        <https://eprel.ec.europa.eu/qr/2251146> ;
    ex:batteryEndurance     <#batteryEndurance> ;
    ex:battery              <battery.ttl#battery> ;
    ex:trace                <trace.ttl#trace> .

<#batteryEndurance>
    a                       qudt:QuantityValue ;
    qudt:numericValue       37.00 ;
    qudt:unit               unit:HR .
