@prefix ex:     <https://example.org/passport/> .
@prefix schema: <https://schema.org/> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .

<#battery>
    a                       ex:Battery ;
    schema:model            "EB-BS942ABE" ;
    schema:mpn              "GH82-39193A" ;
    schema:url              <https://gsmnet.eu/products/samsung-galaxy-s26-s942-battery-eb-bs942abe-service-pack> ;
    ex:chemistry            "Li-ion" ;
    ex:ratedCapacity        <#ratedCapacity> ;
    ex:typicalCapacity      <#typicalCapacity> ;
    ex:nominalVoltage       <#nominalVoltage> ;
    ex:declaredEnergy       <#declaredEnergy> ;
    ex:mass                 <#mass> ;
    schema:manufacturer     <#manufacturer> .

<#ratedCapacity>
    a                       qudt:QuantityValue ;
    qudt:numericValue       4175 ;
    qudt:unit               unit:MilliA-HR .

<#typicalCapacity>
    a                       qudt:QuantityValue ;
    qudt:numericValue       4300 ;
    qudt:unit               unit:MilliA-HR .

<#nominalVoltage>
    a                       qudt:QuantityValue ;
    qudt:numericValue       3.90 ;
    qudt:unit               unit:V .

<#declaredEnergy>
    a                       qudt:QuantityValue ;
    qudt:numericValue       16.29 ;
    qudt:unit               unit:W-HR .

<#mass>
    a                       qudt:QuantityValue ;
    qudt:numericValue       58.0 ;
    qudt:unit               unit:GM .

<#manufacturer>
    a                       schema:Organization ;
    schema:name             "Samsung" ;
    schema:address          <#manufacturer-address> .

# Fictional example address; not supplied by smartphones.csv.
<#manufacturer-address>
    a                       schema:PostalAddress ;
    schema:description      "Fictional address for demonstration only" ;
    schema:streetAddress    "126 Demo Lane" ;
    schema:postalCode       "20095" ;
    schema:addressLocality  "Hamburg" ;
    schema:addressCountry   "DE" .
# Invented demonstration value: battery_mass_g = "58.0" (missing in CSV).
