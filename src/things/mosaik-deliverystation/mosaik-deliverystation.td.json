{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "arena": "https://solid.ti.rw.fau.de/public/ns/arena#"
    }
  ],
  "@type": [
    "arena:Station",
    "arena:Workstation"
  ],
  "title": "deliveryStation",
  "description": "A station at a fixed position on the shopfloor that realises one service. Each of its Actions runs one recipe: it produces the recipe's output product at the station's own position, but only while every input product of that recipe already lies at the station. The Actions themselves differ per station and are given in the instance Thing Descriptions.",
  "securityDefinitions": {
    "nosec_sc": {
      "scheme": "nosec"
    }
  },
  "security": "nosec_sc",
  "properties": {
    "xpos": {
      "type": "number",
      "title": "Position on the x axis",
      "readOnly": true,
      "writeOnly": false,
      "observable": true,
      "@type": "arena:XPosition"
    },
    "ypos": {
      "type": "number",
      "title": "Position on the y axis",
      "readOnly": true,
      "writeOnly": false,
      "observable": true,
      "@type": "arena:YPosition"
    },
    "service": {
      "type": "string",
      "title": "The service this station realises",
      "readOnly": true,
      "writeOnly": false,
      "observable": true
    }
  }
}
