{
  "name": "wot-lab",
  "version": "0.0.1",
  "description": "A Web of Things (WoT) development framework for rapid IoT device prototyping and testing",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "frontend:build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:preview": "vite preview --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "start": "bun run frontend:build && bun src/main.ts",
    "dev": "bun run frontend:build && bun --watch src/main.ts",
    "dev:demo": "bun run frontend:build && bun --watch src/main.ts --things counter:1,lamp:1,vswitch:1",
    "dev:debug": "DEBUG=wot-lab:* bun --watch src/main.ts",
    "dev:debug:core": "DEBUG=wot-lab:system:*,wot-lab:config:*,wot-lab:things:* bun --watch src/main.ts",
    "dev:debug:simulation": "DEBUG=wot-lab:simulation:* bun --watch src/main.ts",
    "dev:cli": "bun --watch src/main.ts --things counter:2,lamp:1",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "counterclient": "bun src/things/counter/exampleClient.ts",
    "lampclient": "bun src/things/lamp/exampleClient.ts",
    "presenceclient": "bun src/things/presence/exampleClient.ts",
    "brightnessclient": "bun src/things/brightness/exampleClient.ts",
    "ruuviclient": "bun src/things/ruuvitag/exampleClient.ts",
    "blergbclient": "bun src/things/blergb/exampleClient.ts"
  },
  "dependencies": {
    "@node-wot/binding-http": "^0.9.1",
    "@node-wot/core": "^0.9.1",
    "@primer/octicons-react": "^19.33.0",
    "@primer/react": "^38.37.0",
    "debug": "^4.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "valtio": "^2.1.5",
    "wot-typescript-definitions": "^0.8.0-SNAPSHOT.31"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/debug": "^4.1.12",
    "@types/node": "^24.0.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.32.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wintechis/wot-lab.git"
  },
  "keywords": [
    "web-of-things",
    "wot",
    "iot",
    "w3c",
    "framework",
    "typescript",
    "node",
    "prototyping"
  ],
  "author": "Thomas Wehr",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/wintchies/wot-lab/issues"
  },
  "homepage": "https://github.com/wintechis/wot-lab#readme"
}
