# An order for one smartphone, as the lab reads them from a pod's `orders/`
# container: the products it is to be made of, each named by the URI the lab serves
# it at. The battery is the Xiaomi 15T spare part; the rest are the raw
# materials the shopfloor's recipe book calls for.
#
# A component is a component because it names a product of this lab, so the
# predicate carrying it is the order author's choice. Change the port if the lab is
# not on 8081.
#
# `schema:orderDate` is when this order asks to have been placed: the lab builds it
# now and records it as having been built then, so the six examples together leave a
# pod with three years of phones. Any `xsd:dateTime` or `xsd:date` literal does, so
# the predicate is the author's choice here too; drop the line to be built as of now.
@prefix schema: <https://schema.org/> .
@prefix ex:     <https://example.org/passport/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<#order>
    a                  schema:Order ;
    schema:name        "One smartphone with the Xiaomi 15T battery" ;
    schema:orderDate   "2025-09-24T10:20:00.000Z"^^xsd:dateTime ;
    schema:description "1330102000188B (Xiaomi BP5J) in place of the generic battery product." ;
    ex:component
                       <http://localhost:8081/products/1330102000188b> ,
                       <http://localhost:8081/products/batterycell> ,
                       <http://localhost:8081/products/ingot> ,
                       <http://localhost:8081/products/comm> ,
                       <http://localhost:8081/products/mainboard2> ,
                       <http://localhost:8081/products/glass> ,
                       <http://localhost:8081/products/lcd> ,
                       <http://localhost:8081/products/cpu> ,
                       <http://localhost:8081/products/flash> ,
                       <http://localhost:8081/products/mainboard> ,
                       <http://localhost:8081/products/ram> ,
                       <http://localhost:8081/products/port> ,
                       <http://localhost:8081/products/mainboard3> ,
                       <http://localhost:8081/products/sensor> .
